@startuml
skinparam classAttributeIconSize 0

' Interfaces
interface Comparable
interface Identifiable
interface VideoCollection<E>
interface LL<E>
interface Tree<E>
interface Graph<V, E>

' Abstract Classes
abstract class BST<E>

' Concrete Data Structures
class SLL<E>
class DLL<E>
class AVLTree<E>
class BSTTree<E>
class AdjacencyMapGraph<V, E>

' Domain entities & Enums
class Video
class Customer
class VideoStore
enum Genre

' VideoCollection hierarchy
LL --|> VideoCollection
Tree --|> VideoCollection

' Linked List implementations
SLL ..|> LL
DLL ..|> LL

' Tree implementations
BST ..|> Tree
AVLTree --|> BST
BSTTree --|> BST

' Graph implementations
AdjacencyMapGraph ..|> Graph

' Entity interfaces & Relationships
Video ..|> Comparable
Video ..|> Identifiable
Customer ..|> Comparable
Customer ..|> Identifiable

Video "1" *-- "*" Genre : has
AdjacencyMapGraph --> Video : stores node
AdjacencyMapGraph --> Genre : stores node

' Composition
VideoStore --> VideoCollection : manages
Customer --> VideoCollection : rentedVideos

@enduml
